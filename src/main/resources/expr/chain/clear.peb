## ===============  clear start ===============
## 清空队列
let chain_{{ funcName }} = lambda()->
    {% if isPostProcessingUDF is not null and isPostProcessingUDF == true %}
       let udf = seq.get(postProcessingUDFMap,"{{ funcName }}");
       let aggregatedData = nil;
       if(!is_empty({% var processedChainQueue %})){
           aggregatedData = {% var processedChainQueue %};
       }else{
           aggregatedData = {% var rawChainQueue %};
       }
       let res =  {{ funcName }}.handle(udf,aggregatedData,{% var chainResult %});
       if(res){
           {% var chainResult %}=nil;
           queue.clear({% var processedChainQueue %});
           queue.clear({% var rawChainQueue %});
       }
       return true;
    {% else%}
       if(!is_empty({% var processedChainQueue %})){
           queue.clear({% var processedChainQueue %});
       }
       if(!is_empty({% var rawChainQueue %})){
           queue.clear({% var rawChainQueue %});
       }
       {% var chainResult %}=nil;
       return true;
    {% endif %}
end;
## ===============  clear end  ===============
